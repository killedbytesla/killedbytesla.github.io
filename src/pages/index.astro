---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, repo, dateLabel } from '../lib/projects';
import { categories, statuses } from '../../scripts/data-schema.mjs';
const entries = await projects();
const windDowns = entries.filter(p => p.data.status === 'Announced wind-down');
const featured = windDowns[0];
const lastReview = entries.map(p => p.data.lastVerified).sort().at(-1)!;
---
<Layout><main id="main">
{featured && <section class="notice" aria-label="Latest update"><span class="notice-label"><i aria-hidden="true"></i> ANNOUNCED WIND-DOWN</span><p>{featured.data.description}</p><a href={`/projects/${featured.id}/`}>Read the record <span aria-hidden="true">→</span></a></section>}
<section class="archive" aria-labelledby="archive-heading"><div class="archive-heading"><h1 id="archive-heading">Project index <span>{String(entries.length).padStart(2,'0')}</span></h1><span class="meta">LATEST REVIEW / {dateLabel(lastReview).toUpperCase()}</span></div>
<form class="filters" role="search" hidden id="filters"><label class="search-label"><span class="search-icon" aria-hidden="true">⌕</span><span class="sr-only">Search projects</span><input type="search" id="search" placeholder="Search the archive…" autocomplete="off"/></label><label><span class="sr-only">Category</span><select id="category"><option value="">All categories</option>{categories.map(c => <option>{c}</option>)}</select></label><label><span class="sr-only">Status</span><select id="status"><option value="">All statuses</option>{statuses.map(s => <option>{s}</option>)}</select></label></form>
<div class="results-bar"><span id="result-count" aria-live="polite">{entries.length} records</span><span>NEWEST ENDING FIRST ↓</span></div><div class="project-grid">{entries.map((project,index) => <ProjectCard project={project} index={index}/>)}</div><div class="empty" id="empty" hidden><h3>No matching records.</h3><p>Try another search or clear the filters.</p><button id="clear" type="button">Clear filters</button></div></section>
<section class="contribution"><div class="contribution-icon" aria-hidden="true">+</div><div><h2>Missing a project?</h2><p>This archive is open source. Add a project, correct a date, or bring a source.</p></div><a class="button" href={`${repo}/issues/new/choose`}>Suggest a change <span aria-hidden="true">↗</span></a></section>
</main></Layout>
<script>
import { matchesProject } from '../../scripts/filter.mjs';
const form = document.querySelector<HTMLFormElement>('#filters')!;
const search = document.querySelector<HTMLInputElement>('#search')!;
const category = document.querySelector<HTMLSelectElement>('#category')!;
const status = document.querySelector<HTMLSelectElement>('#status')!;
const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project]'));
function update() { let count = 0; for (const card of cards) { const visible = matchesProject(card.dataset, search.value, category.value, status.value); card.hidden = !visible; if (visible) count++; } document.querySelector('#result-count')!.textContent = `${count} ${count === 1 ? 'record' : 'records'}`; (document.querySelector('#empty') as HTMLElement).hidden = count > 0; }
form.hidden = false;
form.addEventListener('submit', e => e.preventDefault());
form.addEventListener('input', update);
form.addEventListener('change', update);
document.querySelector('#clear')!.addEventListener('click', () => { form.reset(); update(); search.focus(); });
</script>
