---
import Layout from '../../layouts/Layout.astro';
import { projects, dateLabel, statusClass, repo } from '../../lib/projects';
export async function getStaticPaths() { return (await projects()).map(project => ({ params: { slug: project.id }, props: { project } })); }
const { project } = Astro.props;
const p = project.data;
---
<Layout title={`${p.name} — Killed by Tesla`} description={p.description}><main id="main" class="record"><a class="back" href="/">← Back to project index</a><div class="record-heading"><span class="eyebrow">{p.category} / PROJECT RECORD</span><span class:list={['status', statusClass(p.status)]}><i aria-hidden="true"></i>{p.status}</span></div><h1>{p.name}<span class="red">.</span></h1><p class="record-summary">{p.description}</p><dl class="record-facts"><div><dt>{p.status === 'Cancelled' ? 'Announced' : p.status === 'Absorbed brand' ? 'Founded' : 'Started'}</dt><dd>{dateLabel(p.start)}</dd></div><div><dt>{p.status === 'Announced wind-down' ? 'Planned wind-down' : p.status === 'Absorbed brand' ? 'Acquired' : 'Ended'}</dt><dd>{p.endLabel || dateLabel(p.end)}</dd></div><div><dt>Last verified</dt><dd>{dateLabel(p.lastVerified)}</dd></div></dl><section class="prose"><h2>The record</h2><p>{p.details}</p><h2>About the dates</h2><p>{p.dateNote}</p>{p.announcementDate && <p>Wind-down announced: {dateLabel(p.announcementDate)}. This record remains an announced wind-down until new evidence is reviewed.</p>}<h2>Sources</h2><ol class="sources">{p.sources.map(source => <li><a href={source.url}>{source.title} ↗</a><span class="meta">{source.supports}</span></li>)}</ol></section><div class="record-edit"><span>Have a correction or a better source?</span><a class="button" href={`${repo}/edit/main/src/content/projects/${project.id}.yaml`}>Edit this entry ↗</a></div></main></Layout>
